{
  "expo": {
    "name": "The Trail",
    "slug": "the-trail-nt",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "thetrail",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.purposepress.thetrail",
      "supportsTablet": true,
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.purposepress.thetrail",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#2f5a45"
      }
    },
    "web": {
      "favicon": "./assets/images/favicon.png",
      "output": "single"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-web-browser",
      "expo-audio",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 140,
          "resizeMode": "contain",
          "backgroundColor": "#2f5a45"
        }
      ],
      "expo-status-bar"
    ],
    "experiments": {
      "typedRoutes": false
    }
  }
}
